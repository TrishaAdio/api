# ── Kiro account ────────────────────────────────────────────────────────────
# Create at app.kiro.dev -> API Keys (Pro plan or above)
KIRO_API_KEY=ksk_replace_me

# Absolute path to the Kiro CLI. The server does not inherit an interactive
# login shell's PATH, so a bare "kiro-cli" may not resolve.
# setup.sh fills this in automatically.
KIRO_CLI_BIN=kiro-cli

# ── RioApis console ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# Addresses allowed to open the console, generate API keys and read usage.
# Localhost is always allowed. Not editable from the web UI, so a mistake in
# the browser cannot lock you out.
ADMIN_WHITELIST_IPS=

# Kiro charges per request scaled by the model's credit weight.
# Pay-as-you-go overage is $0.04 per credit.
USD_PER_CREDIT=0.04

# ── API ─────────────────────────────────────────────────────────────────────
# Bootstrap key accepted by /v1 before you mint one in the console.
# Generated keys are managed in the UI and stored hashed.
BRIDGE_API_KEY=

KIRO_DEFAULT_MODEL=auto
KIRO_TIMEOUT_SECONDS=300
KIRO_MAX_CONCURRENCY=4

# Empty = no tools trusted, so it behaves like a plain chat model.
# Set to e.g. read,grep to let it inspect KIRO_BRIDGE_WORKDIR.
KIRO_TRUST_TOOLS=
KIRO_BRIDGE_WORKDIR=/tmp/kiro-bridge

# ── Machine access ──────────────────────────────────────────────────────────
# Whether the model may read, write, delete and run commands on this server.
#
#   off      answers text only (default)
#   console  full tool use from the IP-whitelisted console only
#   all      full tool use from generated API keys too — and those work from
#            ANY address, so anyone holding a key, including a leaked one, gets
#            code execution as the user running RioApis. Prefer "console".
TOOL_ACCESS=off

# Directory the model works in when tools are enabled. Blank uses the scratch
# workdir above. A broad path such as / puts the whole filesystem in reach.
TOOL_ROOT=

# Trust X-Forwarded-For for client IPs. Leave false unless RioApis sits behind
# a reverse proxy that overwrites the header: console access is decided by
# caller IP, and any client can otherwise spoof a whitelisted address.
TRUST_PROXY_HEADERS=false
